# ============================================================================
# 智能语音备忘录 · 环境变量模板
# 使用方式：复制本文件为 .env，然后填入自己的 API Key
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 已在 .gitignore 中，不会被提交。
# ============================================================================

# ---------------------------- DeepSeek API ----------------------------
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 兼容网关可改成自建地址，例如 https://your-gateway.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------- 本地语音识别 ----------------------------
# 后端：auto / funasr / whisper
#   auto（默认）= 装了 funasr 就用 SenseVoiceSmall（中文专用、CPU 上又快又准），
#                 没装就退回 faster-whisper，老环境行为完全不变。
#   funasr      = 强制用 SenseVoiceSmall
#   whisper     = 强制用 faster-whisper
# 想要中文识别率更高，推荐装上（约几百 MB 依赖 + 首次自动下载模型）：
#   pip install funasr
ASR_BACKEND=auto
# SenseVoice 模型名，一般不用改
ASR_FUNASR_MODEL=iic/SenseVoiceSmall
# 下面这几项只在 ASR_BACKEND 落到 faster-whisper 时才生效
# 模型越大越准、越慢：tiny < base < small < medium < large-v3
# base 是纯 CPU 的默认档：比 small 快 2~3 倍、权重小 3 倍，短句备忘足够用；
# 机器很弱就换 tiny，有 NVIDIA 显卡再考虑 small/medium。
# 首次运行会自动下载权重（base 约 150MB），之后完全离线可用
ASR_MODEL=base
# auto 会自动检测 CUDA；纯 CPU 环境保持 auto 即可
ASR_DEVICE=auto
# CPU 用 int8；NVIDIA 显卡用 float16 或 int8_float16
ASR_COMPUTE_TYPE=int8
# 识别语言，中文填 zh；留空则自动检测
ASR_LANGUAGE=zh
# 束搜索宽度：越大越准、越慢。5 是纯 CPU 下的平衡档，有 GPU 可上 8
ASR_BEAM_SIZE=5

# ---------------------------- 医学热词（问诊实训专用）----------------------------
# 留空 = 用内置的医学词表（DEFAULT_MEDICAL_HOTWORDS，见 main.py）；
# 填 off 可整组关掉；也可以整条覆盖成自己的词表（英文逗号分隔）。
# 词表有两个用途：① 当解码提示词喂给模型；② 识别后把同音别字掰回来
ASR_HOTWORDS=
# 是否把热词当 initial_prompt 传给解码器（仅 faster-whisper 支持；
# SenseVoiceSmall 没有这个参数，对它只有"识别后校正"这一路生效）
ASR_INITIAL_PROMPT=true
# 是否在识别后做一次同音字校正（"湿罗音"→"湿啰音"、"心机梗死"→"心肌梗死"）
# 只改写**完整同音**且长度一致的词，避免把"右下腹"改成"右上腹"这类反向错误
ASR_HOTWORD_CORRECT=true

# 送进 ASR 之前的音频预处理（纯 numpy，失败自动跳过、绝不吃掉录音）
# 去直流 → 频谱减降噪 → 响度归一。说话声小、房间有底噪时提升最明显
AUDIO_PREPROCESS=true
AUDIO_DENOISE=true
# 归一目标响度（dBFS），-3 是常用值；觉得声音发闷可调到 -6
AUDIO_TARGET_DBFS=-3.0
# 增益上限（dB）：只放大这么多，避免把底噪一起抬成噪音
AUDIO_MAX_GAIN_DB=18.0

# ---------------------------- VAD 免唤醒断句 ----------------------------
# 静音多久判定"说完了"，单位毫秒。这是最主要的断句方式，纯 VAD、不吃 CPU
VAD_SILENCE_MS=3000
# 低于该长度的片段按噪声丢弃
VAD_MIN_SPEECH_MS=400
# 刚唤醒后不足这个时长又静音 → 认为"还没开始说事"，继续等（避免存下空记录）
VAD_MIN_SEGMENT_MS=800
# 说话开始前的回溯缓冲，避免第一个字被吞掉
PRE_SPEECH_PAD_MS=300
# 单条录音最长时长（秒），到点强制截断
MAX_RECORD_SECONDS=120
# VAD 灵敏度 0~1，环境嘈杂可调到 0.6~0.7
VAD_THRESHOLD=0.5
# 是否支持说"结束/完毕"提前截断（默认 false）
# 该功能每隔约 1.5s 对已录内容跑一次 Whisper，是纯 CPU 环境下最大的性能负担；
# 关掉后断句完全由 silero-vad 负责（只算人声概率，不碰 ASR，极快），
# 说满 3 秒静音就会自动切断。只有确认 CPU 富余（或有 GPU）才建议开。
EARLY_STOP_KEYWORD=false
EARLY_STOP_INTERVAL_SECONDS=1.5
# 结束词列表，英文逗号分隔（仅在 EARLY_STOP_KEYWORD=true 时生效）
STOP_KEYWORDS=结束,完毕,就这些,说完了

# ---------------------------- 唤醒词与语音指令 ----------------------------
# 唤醒词：麦克风一直开着，但只有听到它才开始记录。留空则退回"一直听"的免唤醒模式
# 写成叠词，"小医"和"小医小医"两种说法都能唤醒（叠词会自动折半成候选）
WAKE_WORD=小医小医
# false = 完全不用唤醒词，听到人声就录（安静独处的房间更省事）
WAKE_WORD_ENABLED=true
# 扫描唤醒词/指令用的模型。tiny 最快，纯 CPU 就用它，别改大
WAKE_MODEL=tiny
# 每次扫描回看多长的音频（秒）。太短会漏掉半句，太长会拖慢
WAKE_WINDOW_SECONDS=2.2
# 两次扫描之间至少间隔多久（秒）。指令扫描跑在后台线程，不会阻塞录音
WAKE_SCAN_INTERVAL_SECONDS=0.6
# 模糊匹配阈值 0~1：ASR 常把"小记"听成"小纪/小吉/肖记"，低一点更宽容
WAKE_FUZZY_THRESHOLD=0.72
# 内置同音字表已覆盖「小医/小一/小依/晓医…」这一批常见误写，一般不用填。
# 换成别的唤醒词、或 ASR 老把它听成某个表里没有的字时，在这里补：
#   WAKE_ALIASES=小秘书小秘书,小密书小秘书
WAKE_ALIASES=
# 分段结束词：说到它立刻截断、整理、落库，然后回到待机等下一次唤醒
# 匹配同时看**字面**和**拼音**：ASR 把"录音完毕"写成"錄音完畢""入音完畢"都能认出来
SEGMENT_END_KEYWORDS=录音完毕,下一条,保存这段,这段保存
# 短结束词：双字的口语收尾，也走拼音匹配（"保存"→"宝村""报存"照样触发）。
# 注意这些词**只认句尾**：正文里说"文件我已经保存了"不会被打断，只有整句以它
# 结尾才算。代价是"说完这句就保存"这种挂在句尾的正文会被当成指令截掉。
# 填 off / - / none / 无 可整组关掉，恢复成只能靠长指令词结束。
SHORT_END_KEYWORDS=完毕,保存,好了,收工,就这样,就这些,说完了
# 退出词：保存当前内容后结束整个程序
EXIT_KEYWORDS=退出录制,停止运行,彻底结束
# 作废词：录音途中说到就**丢弃这一段** —— 不转写、不调 DeepSeek、不入库、不写 Markdown
# 与其它指令不同，作废只认"句尾"（"……作废吧"算，正文里的"明天取消会议"不算），
# 因为"取消"在正常内容里太常见，误判一次就白说了。
CANCEL_KEYWORDS=作废,取消,这条不要了,别记录了,不要了

# ---------------------------- Web 看板 ----------------------------
# 网页界面端口（需 pip install flask），打开 http://127.0.0.1:5000
WEB_PORT=5000
# 只监听本机。想用手机在同一局域网里看，改成 0.0.0.0
WEB_HOST=127.0.0.1

# ---------------------------- 存储与导出 ----------------------------
DB_PATH=memos.db
# 每条新备忘录自动追加到这个 Markdown 文档（留空则关闭，只写数据库）
MARKDOWN_PATH=my_memos.md
# 录音开始/保存完成时的终端蜂鸣（Windows 控制台会响；部分终端忽略）
BEEP=true

# ---------------------------- 高级 ----------------------------
# 采集队列缓冲时长（秒）。ASR/LLM 处理期间音频先入队，超时后丢最旧的块
QUEUE_SECONDS=8
